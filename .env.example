APP_NAME="ProPerX Alliance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://properx-portal.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=properx_portal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: Azure Communication Services only ("azure", the default); "log" for local development.
MAIL_MAILER=log
# Platform settings (Key Vault in Azure): endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
KEENEY_ACS_CONNECTION_STRING=
KEENEY_MAIL_FROM=
KEENEY_MAIL_FROM_NAME="ProPerX Alliance"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API Service account key (Key Vault in production). Generate/rotate: php artisan app:api-key:rotate
API_SERVICE_KEY=
API_KEY_ROTATION_OVERLAP_HOURS=24

# Stripe: membership payment status (webhook) and the agency enrollment's payment.
# Local testing: `stripe listen --forward-to https://properx-portal.local/api/webhooks/stripe` prints the secret.
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET=
# Publishable key (pk_...), for the Payment Element on /join/agency.
STRIPE_KEY=
# Optional Customer Portal configuration (bpc_...) for "Manage payment method" on /member/billing; empty: the default.
STRIPE_PORTAL_CONFIGURATION=
PAYMENT_PORTAL_URL=
# After a failed renewal: days of past due with full access, then the membership expires (0 = at once).
# Replaces PAYMENT_GRACE_DAYS, which still counts when this is not set.
MEMBERSHIP_GRACE_DAYS=14
# Renewal reminders (email and the bell), days before the paid period ends; allowed 30, 14, 7, 3, 1.
AGENCY_RENEWAL_REMINDER_DAYS=14,7,1
# Reminders while a renewal payment is overdue, days before access ends; allowed 7, 3, 1.
MEMBERSHIP_GRACE_REMINDER_DAYS=7,1
# Renewal reminders to individual members (properx.org / Stripe may already send them): off unless true.
# Agencies' principals always get theirs.
RENEWAL_REMINDERS_INDIVIDUAL_ENABLED=
# Months a member whose individual subscription was canceled on properx.org waits before applying again
# (the 24-month rule; empty = 24). Staff can lift it per member in Nova.
MEMBERSHIP_REJOIN_WAIT_MONTHS=
# The staff's morning email at 08:00: what waits for each of them, as counts. Off unless true.
STAFF_SUMMARY_ENABLED=
# "Expired" emails and the overdue reminders after a failed renewal. Off by default: the statuses still
# change, only the emails are kept back (counted in the command's log). In production, switch on once the
# texts are approved. Only memberships whose grace period ends after MEMBERSHIP_EXPIRY_EMAILS_SINCE
# (a date; empty = the first run with emails on, recorded by app:expire-memberships) get an email.
MEMBERSHIP_EXPIRY_EMAILS_ENABLED=
MEMBERSHIP_EXPIRY_EMAILS_SINCE=
# Agency membership prices (config/agency.php). Empty: prices are found by their Stripe lookup key
# (agency_founding_2to9, agency_standard_2to9, ...).
STRIPE_PRICE_AGENCY_FOUNDING_2TO9=
STRIPE_PRICE_AGENCY_STANDARD_2TO9=
STRIPE_PRICE_AGENCY_FOUNDING_10TO49=
STRIPE_PRICE_AGENCY_STANDARD_10TO49=
STRIPE_PRICE_AGENCY_FOUNDING_50PLUS=
STRIPE_PRICE_AGENCY_STANDARD_50PLUS=
# States where agencies pay no credit card surcharge (legal address), comma-separated two-letter codes, e.g. CT,MA.
AGENCY_SURCHARGE_EXEMPT_STATES=

# Nova
NOVA_LICENSE_KEY=
NOVA_APP_NAME="ProPerX Alliance"

# Dedicated key for app-level document encryption ("base64:..."); falls back to APP_KEY.
DOCUMENTS_ENCRYPTION_KEY=
# HMAC key for blind indexes of encrypted searchable fields (NPN, Member ID, certificate number).
# Separate from APP_KEY; KEENEY creates it in Key Vault. Locally: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
BLIND_INDEX_KEY=

# Member documents and the certificate cache: private Azure Blob container only.
# Azure (platform settings, managed identity, no account key):
KEENEY_DOCUMENTS_ACCOUNT=
KEENEY_DOCUMENTS_CONTAINER=portal-documents
KEENEY_DOCUMENTS_ENDPOINT=
# Optional: Blob client timeouts in seconds (defaults 20 and 5) so an unreachable account fails fast.
DOCUMENTS_STORAGE_TIMEOUT=
DOCUMENTS_STORAGE_CONNECT_TIMEOUT=
# Optional: client id of a user-assigned managed identity.
AZURE_CLIENT_ID=
# Local development only: the Azurite emulator (`npm run azurite`, then `php artisan app:storage:init`).
# This is Azurite's well-known public development key, not a real account. Never set it in Azure.
AZURITE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
# 2FA is mandatory for every Nova user; "false" is honoured only when APP_ENV=local.
NOVA_REQUIRE_2FA=true
PORTAL_SCHEDULE_TIMEZONE=America/New_York
# "true" opens the public agency enrollment wizard (/join/agency); off (404) by default.
AGENCY_ENROLLMENT_ENABLED=
# Agency employees (W2) billed like producers (empty = true). "false": they count toward the two-member minimum only.
AGENCY_BILL_EMPLOYEES=
# Licensed producers need a license copy before the agency pays (empty = true). "false" relaxes it.
AGENCY_REQUIRE_LICENSE_COPY=
# "New agency enrolled" is also emailed here when set (staff always see it in Nova).
AGENCY_STAFF_NOTIFICATION_EMAIL=
# The agency owner's welcome (sent when the enrollment is paid): [Portal Login Link] (empty: the portal's
# sign-in page), the health enrollment application attached (a path in the image, relative to the app
# root, or absolute; empty or missing: sent without it) and the reply-to address the email asks to reply to.
AGENCY_WELCOME_LOGIN_URL=
AGENCY_WELCOME_ATTACHMENT=
AGENCY_WELCOME_REPLY_TO=

# Paid applications from properx.org (POST /api/intake/individual)
INTAKE_ENABLED=
WP_INTAKE_SECRET=
INTAKE_SEND_INVITE=
# Individual membership application on the marketing site ("Just me" on /join/agency), e.g. https://properx.org/apply/.
INDIVIDUAL_MEMBERSHIP_URL=
# "true": "My agency" on properx.org/apply opens a prefilled enrollment (POST /api/intake/agency-start, signed with
# WP_INTAKE_SECRET). Needs AGENCY_ENROLLMENT_ENABLED. Off (404) by default.
AGENCY_HANDOFF_ENABLED=
# Terms of Service and Privacy Policy, linked from the agency enrollment's consents (default: properx.org's pages).
PORTAL_TERMS_URL=
PORTAL_PRIVACY_URL=
# "Contact support" link on the sign-in page (https:// or mailto:).
PORTAL_SUPPORT_URL=
# "Billing" in the member sidebar: hidden until its page exists (a Nova path such as /billing).
PORTAL_BILLING_PATH=
# The member area (/member); off by default: members use Nova.
MEMBER_AREA_ENABLED=
# Benefits tab: "Enroll" for health, dental and vision, and for pet insurance (empty: the my-benefits.net forms
# in config/portal.php); "Choose a Plan" per benefit (empty: no button).
BENEFITS_HEALTH_ENROLL_URL=
BENEFITS_PET_ENROLL_URL=
BENEFITS_HEALTH_PLAN_URL=
BENEFITS_DENTAL_PLAN_URL=
BENEFITS_VISION_PLAN_URL=
BENEFITS_PET_PLAN_URL=

# Certificate: optional first signature, bottom left, the name set in type (empty = none, as in production);
# second signature, bottom right (empty = the date of issue stands in its place) and the file name of that
# signatory's signature (transparent PNG) in resources/views/pdf/images (empty = the name is set in type).
# Production values below.
CERTIFICATE_FIRST_SIGNATORY_NAME=
CERTIFICATE_FIRST_SIGNATORY_TITLE=
CERTIFICATE_SECOND_SIGNATORY_NAME="Anne Glorioso"
CERTIFICATE_SECOND_SIGNATORY_TITLE="Founder and CEO"
CERTIFICATE_SIGNATURE_IMAGE=signature-anne-glorioso.png
# Local development only: "true" allows `php artisan migrate:fresh --seeder=DemoSeeder` (fictional data).
DEMO_SEED_ALLOWED=
# Optional, with DEMO_SEED_ALLOWED: one demo login per role on plus addresses of this inbox
# (e.g. you+director@example.com). No passwords are printed: use "Forgot your password?"
# or `php artisan app:password-link <email>`.
DEMO_LOGIN_EMAIL=
