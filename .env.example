APP_NAME="ProPerx Member Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://properx-portal.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=properx_portal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: Azure Communication Services only ("azure", the default); "log" for local development.
MAIL_MAILER=log
# Platform settings (Key Vault in Azure): endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
KEENEY_ACS_CONNECTION_STRING=
KEENEY_MAIL_FROM=
KEENEY_MAIL_FROM_NAME="ProPerx Alliance"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API Service account key (Key Vault in production). Generate/rotate: php artisan app:api-key:rotate
API_SERVICE_KEY=
API_KEY_ROTATION_OVERLAP_HOURS=24

# Stripe membership payment status (webhook only; the portal takes no payments).
# Local testing: `stripe listen --forward-to https://properx-portal.local/api/webhooks/stripe` prints the secret.
STRIPE_WEBHOOK_SECRET=
PAYMENT_PORTAL_URL=
PAYMENT_GRACE_DAYS=14
# Agency membership prices (config/agency.php). Empty: prices are found by their Stripe lookup key
# (agency_founding_2to9, agency_standard_2to9, ...).
STRIPE_PRICE_AGENCY_FOUNDING_2TO9=
STRIPE_PRICE_AGENCY_STANDARD_2TO9=
STRIPE_PRICE_AGENCY_FOUNDING_10TO49=
STRIPE_PRICE_AGENCY_STANDARD_10TO49=
STRIPE_PRICE_AGENCY_FOUNDING_50PLUS=
STRIPE_PRICE_AGENCY_STANDARD_50PLUS=

# Nova
NOVA_LICENSE_KEY=
NOVA_APP_NAME="ProPerx Alliance"

# Dedicated key for app-level document encryption ("base64:..."); falls back to APP_KEY.
DOCUMENTS_ENCRYPTION_KEY=
# HMAC key for blind indexes of encrypted searchable fields (NPN, Member ID, certificate number).
# Separate from APP_KEY; KEENEY creates it in Key Vault. Locally: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
BLIND_INDEX_KEY=

# Member documents and the certificate cache: private Azure Blob container only.
# Azure (platform settings, managed identity, no account key):
KEENEY_DOCUMENTS_ACCOUNT=
KEENEY_DOCUMENTS_CONTAINER=portal-documents
KEENEY_DOCUMENTS_ENDPOINT=
# Optional: Blob client timeouts in seconds (defaults 20 and 5) so an unreachable account fails fast.
DOCUMENTS_STORAGE_TIMEOUT=
DOCUMENTS_STORAGE_CONNECT_TIMEOUT=
# Optional: client id of a user-assigned managed identity.
AZURE_CLIENT_ID=
# Local development only: the Azurite emulator (`npm run azurite`, then `php artisan app:storage:init`).
# This is Azurite's well-known public development key, not a real account. Never set it in Azure.
AZURITE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
# 2FA is mandatory for every Nova user; "false" is honoured only when APP_ENV=local.
NOVA_REQUIRE_2FA=true
PORTAL_SCHEDULE_TIMEZONE=America/New_York
# "true" opens the public agency enrollment wizard (/join/agency); off (404) by default.
AGENCY_ENROLLMENT_ENABLED=
# Individual membership application on the marketing site ("Just me" on /join/agency).
INDIVIDUAL_MEMBERSHIP_URL=
# "Contact support" link on the sign-in page (https:// or mailto:).
PORTAL_SUPPORT_URL=
# "Billing" in the member sidebar: hidden until its page exists (a Nova path such as /billing).
PORTAL_BILLING_PATH=
# The new member area (/member, docs/specs/member-area.md); off until finished: members use Nova.
MEMBER_AREA_ENABLED=
# Local development only: "true" allows `php artisan migrate:fresh --seeder=DemoSeeder` (fictional data).
DEMO_SEED_ALLOWED=
# Optional, with DEMO_SEED_ALLOWED: one demo login per role on plus addresses of this inbox
# (e.g. you+director@example.com). No passwords are printed: use "Forgot your password?"
# or `php artisan app:password-link <email>`.
DEMO_LOGIN_EMAIL=
